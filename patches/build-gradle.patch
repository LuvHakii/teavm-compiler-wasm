+    }
+}
+
+def jdkSrcZip = providers.gradleProperty("jdkSrcZip").orElse(provider { "${System.getProperty('java.home')}/lib/src.zip" })
+
+def generateJavadocIndex = tasks.register("generateJavadocIndex", Exec) {
