+    inputs.file input
+    inputs.file wasmGCDir.map { it.file("compiler.wasm") }
+    outputs.dir patchedDir
+    doLast {
+        def js = input.get().asFile.text
+        [['if(typeof t!=="undefined"){t(e.queue,e.ref)}',
+          'if(typeof t!=="undefined"){const q=e.queue.deref(),f=e.ref.deref();if(q!==void 0&&f!==void 0){t(q,f)}}'],
+         ['r.register(e,{ref:t,queue:n})', 'r.register(e,{ref:new WeakRef(t),queue:new WeakRef(n)})']].each { from, to ->
+            def count = js.split(java.util.regex.Pattern.quote(from), -1).length - 1
+            if (count != 1) {
+                throw new GradleException("runtime patch anchor matched ${count} times (expected 1): ${from}")
+            }
+            js = js.replace(from, to)
+        }
+        def dir = patchedDir.get().asFile
+        dir.mkdirs()
+        new File(dir, "compiler.wasm-runtime.js").text = js
+        java.nio.file.Files.copy(wasmGCDir.get().file("compiler.wasm").asFile.toPath(),
+                new File(dir, "compiler.wasm").toPath(), java.nio.file.StandardCopyOption.REPLACE_EXISTING)
+    }
+}
+
+def buildClassSnapshot = tasks.register("buildClassSnapshot", Exec) {
