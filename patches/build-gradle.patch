+    inputs.property "jdkRevision", providers.gradleProperty("jdk.revision")
+    outputs.file output
+    doLast {
+        def file = output.get().asFile
+        file.parentFile.mkdirs()
+        file.text = groovy.json.JsonOutput.toJson([java: "TeaVM ${teavmVersion} / javac ${javacVersion}"]) + "\n"
+    }
+}
+
